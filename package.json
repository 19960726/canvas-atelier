{
  "name": "canvas-agent-mvp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p packages/domain/tsconfig.json --noEmit && tsc -p apps/renderer/tsconfig.json --noEmit",
    "build": "npm run typecheck && npm run build -w @agent-canvas/renderer",
    "e2e": "echo \"e2e not configured yet\""
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
